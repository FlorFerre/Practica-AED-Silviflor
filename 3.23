ACCION Arreglo_3.23 (PACI: arreglo [1..4,1..7,1..50] de entero) ES
   
 AMBIENTE
    sal: arreglo [1..50,1..7] de entero
    max,min,f,j,s,: entero
    dmax,lmax,dmin,lmin: entero
lect: entero
    dia: AN(10)


   PROCESO

    Para f:= 1 hasta 50 hacer
       Para j:= 1 hasta 7 hacer
       sal[f, j]:=0
       FP
    FP        
   
     PARA s:= 1 HASTA 50 HACER


        min:= PACI[1,1,s]        
        max:= PACI[1,1,s]        


        PARA j:= 1 HASTA 7 HACER 
         
            PARA f:=  1 HASTA 4 HACER


                SI PACI[f,j,s] > max ENTONCES
                    max:=  PACI[f,j,s]
                    dmax:= j
                    lmax:= f
                FS

                 lect:=0

                SI PACI[f,j,s] < min ENTONCES
                    min:= PACI[f,j,s]
                    dmin:= j
                    lect:= f
                FS
                sal[s,j]:= sal[s,j] + PACI[f,j,s] div 4
            FP  
        FP
        ESC("Temperatura Maxima del paciente:",s, "es", max, "En la lectura:",lmax, "En el dia":, dmax)
        ESC("Temperatura Minima del paciente:", s,  "es", min, "En la lectura:",lmin, "En el dia":, dmin)
    FP
    
    PARA f:= 1 HASTA 50 HACER 
        ESC("Paicente: ", f)
        PARA j:= 1 HASTA 7 HACER 
            ESC("El promedio para el dia", j, "es de: ", sal[f,j])
        FP
    FP
Fin_accion.
