// ejercicio 3.09 Se posee un arreglo de 200 libros con el siguiente formato:
//NRO_LIBRO	TITULO	AUTOR	CANT_HOJAS ordenado por AUTOR y se presentan las siguientes premisas:
//Se necesita saber que libros se poseen de “Nicklaus Wirth”.
//Se necesita saber en qué posición se encuentra “Algoritmos + Estructuras de Datos=Programa”.
//Se necesita saber cual es el libro de “Nicklaus Wirth” de mayor volumen.


ACCION 3.9 (lib: arreglo de (1...200) de entero) ES 

AMBIENTE

    max, i : entero
    libros = registros
        nrol: N(10) 
        tit: N(50)
        autor: AN(20)
        canth: N(80)
    finregistro

PROCESO

    max:= 1 

    PARA i:= 1 hasta 200 HACER 
        SI lib (i).autor = "Nicklaus Wirth" ENT
            ESC ("....", lib(i).tit)
            si LIB (max).canth < lib(i).canth ENT
                max:= i 
            FINSI
        Finsi 

        Si lib (i).tit = "Algoritmos + estructura de datos =programa " ENT 
            ESC ("...", i )
        FINSI
    FINPARA

    ESC ("El libro de NW de mayor volumen es", lib(max).tit "concant hojas", lib (max).canth)
FINACCION
