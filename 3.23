ACCION Arreglo_3.23 (PACI: arreglo [1..4,1..7,1..50] de entero) ES
    AMBIENTE
    SAL: arreglo [1..50,1..7] de entero
    MAXIMA,MINIMA,I,J,K,: entero
    DIAMAX,LECTURAMX,DIAMIN,LECTURAMIN: entero
    DIA: AN(10)


    PROCESO
    Para i:= 1 hasta 50 hacer
Para j:= 1 hasta 7 hacer
SAL[I, J]:=0
FP
FP        
    PARA K:= 1 HASTA 50 HACER //paciente


        MINIMA:= PACI[1,1,K]        # otra forma seria minima:= HV
        MAXIMA:= PACI[1,1,K]        # maxima := LV


        PARA J:= 1 HASTA 7 HACER // dia
         
            PARA I:=  1 HASTA 4 HACER // lectura


                SI PACI[I,J,K] > MAXIMA ENTONCES
                    MAXIMA:=  PACI[I,J,K]
                    DIAMAX:= J
                    LECTURAMAX:= I
                FS


                SI PACI[I,J,K] < MINIMA ENTONCES
                    MINIMA:= PACI[I,J,K]
                    DIAMIN:= J
                    LECTURA:= I
                FS
                SAL[K,J]:= SAL[K,J] + PACI[I,J,K] div 4
            FP  
        FP
        ESC("Temperatura Maxima del paciente:",K, "es", MAXIMA, "En la lectura:",LECTURAMAX, "En el dia":, DIAMAX)
        ESC("Temperatura Minima del paciente:",K, "es", MINIMA, "En la lectura:",LECTURAMIN, "En el dia":, DIAMIN)
    FP
    //recorrer el arreglo de promedios para mostrarlo
    PARA I:= 1 HASTA 50 HACER //filas son pacientes
        ESC("Paicente: ", I)
        PARA J:= 1 HASTA 7 HACER //columnas son dias
            ESC("El promedio para el dia", J, "es de: ", SAL[I,J])
        FP
    FP
Fin_accion.
